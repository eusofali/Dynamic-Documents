 "css": ".doc-page .pbox{overflow:hidden}",
 "pages": [
  {
   "class": "ov-page",
   "html": "<div class=\"ov\" style=\"transform:translate({{cal_x}}mm,{{cal_y}}mm)\">\n<div class=\"o\" style=\"left:17.0mm;top:44.4mm;width:40.8mm\">{{issue_date}}</div>\n<div class=\"o\" style=\"left:89.7mm;top:59.3mm;width:27.2mm\">{{lic_no}}</div>\n<div class=\"o\" style=\"left:97.9mm;top:82.6mm;width:93.8mm\">{{biz_name}}</div>\n<div class=\"o\" style=\"left:97.9mm;top:92.2mm;width:93.8mm\">{{owner}}</div>\n<div class=\"o\" style=\"left:60.5mm;top:101.9mm;width:131.8mm\">{{mother}}</div>\n<div class=\"o\" style=\"left:59.8mm;top:111.4mm;width:132.5mm\">{{father}}</div>\n<div class=\"o\" style=\"left:123.7mm;top:117.8mm;width:68.0mm\">{{nature}}</div>\n<div class=\"o\" style=\"left:63.9mm;top:124.0mm;width:128.4mm\">{{biz_type}}</div>\n<div class=\"o sm\" style=\"left:110.8mm;top:131.6mm;width:81.6mm\">{{biz_address}}</div>\n<div class=\"o\" style=\"left:165.1mm;top:139.9mm;width:28.5mm\">{{ward}}</div>\n<div class=\"o\" style=\"left:132.5mm;top:145.4mm;width:61.2mm\">{{nid}}</div>\n<div class=\"o\" style=\"left:52.3mm;top:151.6mm;width:62.5mm\">{{tin}}</div>\n<div class=\"o\" style=\"left:158.3mm;top:151.6mm;width:35.3mm\">{{bin}}</div>\n<div class=\"o\" style=\"left:81.6mm;top:157.9mm;width:44.9mm\">{{phone}}</div>\n<div class=\"o sm\" style=\"left:159.7mm;top:157.9mm;width:32.6mm\">{{email}}</div>\n<div class=\"o\" style=\"left:51.4mm;top:170.6mm;width:53.7mm\">{{pv_village}}</div>\n<div class=\"o\" style=\"left:46.9mm;top:178.1mm;width:58.4mm\">{{pv_po}}</div>\n<div class=\"o\" style=\"left:51.0mm;top:185.2mm;width:54.4mm\">{{pv_post}}</div>\n<div class=\"o\" style=\"left:70.7mm;top:192.5mm;width:34.0mm\">{{pv_upazila}}</div>\n<div class=\"o\" style=\"left:38.7mm;top:199.9mm;width:65.2mm\">{{pv_district}}</div>\n<div class=\"o\" style=\"left:141.4mm;top:170.6mm;width:52.3mm\">{{#if same_addr}}{{pv_village}}{{else}}{{pm_village}}{{/if}}</div>\n<div class=\"o\" style=\"left:135.2mm;top:178.1mm;width:58.4mm\">{{#if same_addr}}{{pv_po}}{{else}}{{pm_po}}{{/if}}</div>\n<div class=\"o\" style=\"left:140.7mm;top:185.2mm;width:52.3mm\">{{#if same_addr}}{{pv_post}}{{else}}{{pm_post}}{{/if}}</div>\n<div class=\"o\" style=\"left:161.1mm;top:192.5mm;width:32.6mm\">{{#if same_addr}}{{pv_upazila}}{{else}}{{pm_upazila}}{{/if}}</div>\n<div class=\"o\" style=\"left:127.8mm;top:199.9mm;width:65.2mm\">{{#if same_addr}}{{pv_district}}{{else}}{{pm_district}}{{/if}}</div>\n<div class=\"o\" style=\"left:129.1mm;top:206.3mm;width:27.2mm\">{{#if fee_license}}{{fee_license}}/-{{/if}}</div>\n<div class=\"o\" style=\"left:68.0mm;top:212.2mm;width:27.2mm\">{{#if fee_tax}}{{fee_tax}}/-{{/if}}</div>\n<div class=\"o\" style=\"left:40.1mm;top:219.2mm;width:27.2mm\">{{#if fee_vat}}{{fee_vat}}/-{{/if}}</div>\n<div class=\"o\" style=\"left:46.2mm;top:225.9mm;width:34.0mm\">{{#if fee_total}}{{fee_total}}/-{{/if}}</div>\n<div class=\"o\" style=\"left:130.2mm;top:234.0mm;width:5.4mm\">{{from_digit}}</div>\n<div class=\"o\" style=\"left:166.9mm;top:234.0mm;width:5.4mm\">{{to_digit}}</div>\n<div class=\"o pbox\" style=\"left:157.7mm;top:28.1mm;width:35.6mm;height:37.6mm\">{{photo}}</div>\n</div>"
  }
 ]
