{
 "id": "utility_connection_application",
 "version": 1,
 "title": "সংযোগের আবেদন (বিদ্যুৎ / পানি / গ্যাস / ইন্টারনেট)",
 "title_en": "Utility Connection Request",
 "category": "আবেদন / Applications",
 "icon": "fa-plug",
 "description": "নতুন সংযোগ, লোড বৃদ্ধি, স্থানান্তর বা বিচ্ছিন্নের আবেদন।",
 "page": {
  "size": "a4",
  "marginTop": "0.7in",
  "margin": "1in",
  "fontSize": 16,
  "lineHeight": 1.55,
  "font": "bn"
 },
 "digits": "bn",
 "letterhead": true,
 "groups": [
  {
   "id": "g_to",
   "title": "প্রাপক ও তারিখ",
   "icon": "fa-envelope"
  },
  {
   "id": "g_me",
   "title": "আবেদনকারীর তথ্য",
   "icon": "fa-user"
  },
  {
   "id": "g_ut",
   "title": "সংযোগের তথ্য",
   "icon": "fa-bolt"
  },
  {
   "id": "g_att",
   "title": "সংযুক্তি",
   "icon": "fa-paperclip"
  }
 ],
 "fields": [
  {
   "name": "date",
   "label": "তারিখ",
   "type": "date",
   "col": 4,
   "group": "g_to",
   "required": true,
   "default": "today"
  },
  {
   "name": "addressee",
   "label": "প্রাপকের পদবী",
   "type": "text",
   "col": 8,
   "group": "g_to",
   "required": true,
   "default": "ব্যবস্থাপক / নির্বাহী প্রকৌশলী"
  },
  {
   "name": "org",
   "label": "প্রতিষ্ঠান / অফিসের নাম",
   "type": "text",
   "col": 6,
   "group": "g_to",
   "required": true
  },
  {
   "name": "org_address",
   "label": "প্রতিষ্ঠানের ঠিকানা (ঐচ্ছিক)",
   "type": "text",
   "col": 6,
   "group": "g_to"
  },
  {
   "name": "name",
   "label": "আবেদনকারীর নাম",
   "type": "text",
   "col": 6,
   "group": "g_me",
   "required": true
  },
  {
   "name": "father",
   "label": "পিতা/স্বামীর নাম",
   "type": "text",
   "col": 6,
   "group": "g_me"
  },
  {
   "name": "address",
   "label": "ঠিকানা",
   "type": "text",
   "col": 8,
   "group": "g_me",
   "required": true,
   "placeholder": "গ্রাম/মহল্লা, ডাকঘর, উপজেলা, জেলা"
  },
  {
   "name": "mobile",
   "label": "মোবাইল নম্বর",
   "type": "text",
   "col": 4,
   "group": "g_me",
   "required": true,
   "bn": true
  },
  {
   "name": "svc",
   "label": "সেবার ধরন",
   "type": "select",
   "col": 4,
   "group": "g_ut",
   "options": [
    "বিদ্যুৎ",
    "পানি",
    "গ্যাস",
    "ইন্টারনেট"
   ],
   "default": "বিদ্যুৎ"
  },
  {
   "name": "ctype",
   "label": "আবেদনের বিষয়",
   "type": "select",
   "col": 4,
   "group": "g_ut",
   "options": [
    "নতুন সংযোগ",
    "লোড বৃদ্ধি",
    "সংযোগ স্থানান্তর",
    "সংযোগ বিচ্ছিন্ন"
   ],
   "default": "নতুন সংযোগ"
  },
  {
   "name": "use",
   "label": "ব্যবহারের ধরন",
   "type": "select",
   "col": 4,
   "group": "g_ut",
   "options": [
    "আবাসিক",
    "বাণিজ্যিক",
    "কৃষি"
   ],
   "default": "আবাসিক"
  },
  {
   "name": "premises",
   "label": "সংযোগের স্থানের ঠিকানা",
   "type": "text",
   "col": 8,
   "group": "g_ut",
   "required": true
  },
  {
   "name": "load",
   "label": "প্রয়োজনীয় লোড / ক্ষমতা (থাকলে)",
   "type": "text",
   "col": 4,
   "group": "g_ut"
  },
  {
   "name": "attachments",
   "label": "সংযুক্তি (প্রতি লাইনে একটি; না লাগলে মুছে দিন)",
   "type": "textarea",
   "col": 12,
   "group": "g_att",
   "rows": 3,
   "default": "১। জাতীয় পরিচয়পত্রের ফটোকপি।\n২। জমি/বাড়ির মালিকানার কাগজ বা ভাড়ার চুক্তিপত্র।\n৩। পাসপোর্ট সাইজের ছবি ০১ কপি।"
  }
 ],
 "css": ".doc-page .letter-sign{display:flex;justify-content:space-between;align-items:flex-end;gap:24px;margin-top:34px;break-inside:avoid}.doc-page .letter-att{font-size:.92em;max-width:50%}.doc-page .letter-me{text-align:right;line-height:1.4}.doc-page .letter p{margin-bottom:.8em}",
 "pages": [
  {
   "html": "<div class=\"letter\">\n<p class=\"mb-3\">তারিখ: {{date}} ইং</p>\n<p class=\"mb-3\">বরাবর,<br>{{addressee}}<br>{{org}}{{#if org_address}}<br>{{org_address}}{{/if}}</p>\n<p class=\"mb-3\"><strong>বিষয়ঃ {{use}} {{svc}} {{ctype}} এর জন্য আবেদন।</strong></p>\n<p class=\"mb-2\">{জনাব|মহোদয়},</p>\n<div class=\"text-justify\">\n<p>{সবিনয় নিবেদন এই যে,|বিনীত নিবেদন এই যে,} আমি <strong>{{premises}}</strong> ঠিকানার বাসিন্দা / ব্যবহারকারী। উক্ত স্থানে {{use}} কাজের জন্য আমার <strong>{{svc}} {{ctype}}</strong>{{#if load}} ({{load}}){{/if}} প্রয়োজন।</p>\n<p>{অতএব, মহোদয়ের নিকট বিনীত প্রার্থনা,|অতএব, মহোদয়ের নিকট বিনীত অনুরোধ,} প্রয়োজনীয় ফি ও নিয়মাবলি পরিপালন সাপেক্ষে {আমার আবেদন মঞ্জুর করে বাধিত করবেন|আমার আবেদনটি গ্রহণ করে প্রয়োজনীয় ব্যবস্থা নেবেন}।</p>\n</div>\n<div class=\"letter-sign\">\n<div class=\"letter-att\">{{#if attachments}}<strong>সংযুক্তিঃ</strong><br>{{attachments}}{{/if}}</div>\n<div class=\"letter-me\">{বিনীত নিবেদক|নিবেদক},<br><br><br>_______________________<br><strong>{{name}}</strong>{{#if father}}<br>পিতা/স্বামী- {{father}}{{/if}}<br>{{address}}<br>মোবাইল- {{mobile}}</div>\n</div>\n</div>"
  }
 ]
}
