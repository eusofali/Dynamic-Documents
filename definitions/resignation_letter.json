{
 "id": "resignation_letter",
 "version": 1,
 "title": "পদত্যাগপত্র",
 "title_en": "Resignation Letter",
 "category": "আবেদন / Applications",
 "icon": "fa-door-open",
 "description": "চাকরি থেকে পদত্যাগের আবেদন; শেষ কর্মদিবস ও কারণ ঐচ্ছিক।",
 "page": {
  "size": "a4",
  "marginTop": "0.7in",
  "margin": "1in",
  "fontSize": 16,
  "lineHeight": 1.55,
  "font": "bn"
 },
 "digits": "bn",
 "letterhead": true,
 "groups": [
  {
   "id": "g_to",
   "title": "প্রাপক ও তারিখ",
   "icon": "fa-envelope"
  },
  {
   "id": "g_me",
   "title": "আবেদনকারীর তথ্য",
   "icon": "fa-user"
  },
  {
   "id": "g_rs",
   "title": "পদত্যাগের তথ্য",
   "icon": "fa-door-open"
  }
 ],
 "fields": [
  {
   "name": "date",
   "label": "তারিখ",
   "type": "date",
   "col": 4,
   "group": "g_to",
   "required": true,
   "default": "today"
  },
  {
   "name": "addressee",
   "label": "প্রাপকের পদবী",
   "type": "text",
   "col": 8,
   "group": "g_to",
   "required": true,
   "default": "ব্যবস্থাপনা পরিচালক / ব্যবস্থাপক"
  },
  {
   "name": "org",
   "label": "প্রতিষ্ঠানের নাম",
   "type": "text",
   "col": 6,
   "group": "g_to",
   "required": true
  },
  {
   "name": "org_address",
   "label": "প্রতিষ্ঠানের ঠিকানা (ঐচ্ছিক)",
   "type": "text",
   "col": 6,
   "group": "g_to"
  },
  {
   "name": "name",
   "label": "আবেদনকারীর নাম",
   "type": "text",
   "col": 6,
   "group": "g_me",
   "required": true
  },
  {
   "name": "father",
   "label": "পিতা/স্বামীর নাম",
   "type": "text",
   "col": 6,
   "group": "g_me"
  },
  {
   "name": "address",
   "label": "ঠিকানা",
   "type": "text",
   "col": 8,
   "group": "g_me",
   "required": true,
   "placeholder": "গ্রাম/মহল্লা, ডাকঘর, উপজেলা, জেলা"
  },
  {
   "name": "mobile",
   "label": "মোবাইল নম্বর",
   "type": "text",
   "col": 4,
   "group": "g_me",
   "required": true,
   "bn": true
  },
  {
   "name": "designation",
   "label": "আপনার পদবী",
   "type": "text",
   "col": 6,
   "group": "g_rs",
   "required": true
  },
  {
   "name": "last_day",
   "label": "শেষ কর্মদিবস",
   "type": "date",
   "col": 6,
   "group": "g_rs",
   "required": true
  },
  {
   "name": "reason",
   "label": "কারণ (ঐচ্ছিক)",
   "type": "text",
   "col": 12,
   "group": "g_rs",
   "placeholder": "যেমন: উচ্চশিক্ষা / ব্যক্তিগত ও পারিবারিক কারণ"
  },
  {
   "name": "thanks",
   "label": "প্রতিষ্ঠানকে ধন্যবাদ জানানোর লাইন যুক্ত করুন",
   "type": "checkbox",
   "col": 12,
   "group": "g_rs",
   "default": true
  }
 ],
 "css": ".doc-page .letter-sign{display:flex;justify-content:space-between;align-items:flex-end;gap:24px;margin-top:34px;break-inside:avoid}.doc-page .letter-att{font-size:.92em;max-width:50%}.doc-page .letter-me{text-align:right;line-height:1.4}.doc-page .letter p{margin-bottom:.8em}",
 "pages": [
  {
   "html": "<div class=\"letter\">\n<p class=\"mb-3\">তারিখ: {{date}} ইং</p>\n<p class=\"mb-3\">বরাবর,<br>{{addressee}}<br>{{org}}{{#if org_address}}<br>{{org_address}}{{/if}}</p>\n<p class=\"mb-3\"><strong>বিষয়ঃ পদত্যাগের আবেদন।</strong></p>\n<p class=\"mb-2\">{জনাব|মহোদয়},</p>\n<div class=\"text-justify\">\n<p>{সবিনয় নিবেদন এই যে,|বিনীত নিবেদন এই যে,} আমি আপনার প্রতিষ্ঠানে <strong>{{designation}}</strong> পদে কর্মরত আছি।{{#if reason}} {{reason}} আমি{{else}} আমি ব্যক্তিগত কারণে{{/if}} উক্ত পদ থেকে পদত্যাগ করতে ইচ্ছুক।</p>\n<p>আমার শেষ কর্মদিবস হবে <strong>{{last_day}} ইং</strong>। এর মধ্যে আমার দায়িত্ব বুঝিয়ে দেব।{{#if thanks}} এতদিন কাজ করার সুযোগ দেওয়ার জন্য আপনাদের নিকট আমি কৃতজ্ঞ।{{/if}}</p>\n<p>{অতএব, মহোদয়ের নিকট বিনীত প্রার্থনা,|অতএব, মহোদয়ের নিকট বিনীত অনুরোধ,} আমার পদত্যাগপত্র {গ্রহণ করে বাধিত করবেন|গ্রহণ করার প্রয়োজনীয় ব্যবস্থা নেবেন}।</p>\n</div>\n<div class=\"letter-sign\">\n<div class=\"letter-att\">{{#if attachments}}<strong>সংযুক্তিঃ</strong><br>{{attachments}}{{/if}}</div>\n<div class=\"letter-me\">{বিনীত নিবেদক|নিবেদক},<br><br><br>_______________________<br><strong>{{name}}</strong>{{#if father}}<br>পিতা/স্বামী- {{father}}{{/if}}<br>{{address}}<br>মোবাইল- {{mobile}}</div>\n</div>\n</div>"
  }
 ]
}
