{
 "id": "trade_license_up",
 "version": 1,
 "title": "ট্রেড লাইসেন্স – ইউনিয়ন পরিষদ ফর্মে ছাপা",
 "title_en": "Trade Licence – print on UP pre-printed form",
 "category": "ফর্ম প্রিন্ট / Pre-printed forms",
 "icon": "fa-id-card",
 "description": "ইউনিয়ন পরিষদের প্রি-প্রিন্টেড ট্রেড লাইসেন্স কাগজে ১১টি ঘরের তথ্য নির্ভুল জায়গায় ছাপার জন্য (সীল/স্বাক্ষর/লোগো ছাপা হয় না)।",
 "notice": "শুধু সরকার/পৌরসভা/ইউনিয়ন পরিষদের অনুমোদিত প্রি-প্রিন্টেড লাইসেন্স কাগজে তথ্য ছাপার জন্য। এই টুল সীল, স্বাক্ষর, লোগো বা QR কোড তৈরি করে না। লাইসেন্স নম্বর, ফি ও মেয়াদ কর্তৃপক্ষের রেকর্ড অনুযায়ী হুবহু বসাতে হবে। প্রথমে সাদা কাগজে প্রিন্ট করে প্রি-প্রিন্টেড কাগজের সাথে মিলিয়ে নিন (উপরের “Guide” বাটনে ফর্মের স্ক্যান দিলে পর্দায় মিলিয়ে দেখা যায়; “মিলানোর সমন্বয়” দিয়ে সরান – মনে থাকবে)।",
 "guide": true,
 "page": {
  "size": "a4",
  "marginTop": "0",
  "margin": "0",
  "fontSize": 16,
  "lineHeight": 1.2,
  "font": "bn"
 },
 "digits": "bn",
 "groups": [
  {
   "id": "g_cal",
   "title": "মিলানোর সমন্বয় (প্রিন্টার/কাগজ অনুযায়ী একবার ঠিক করুন)",
   "icon": "fa-arrows-alt"
  },
  {
   "id": "g_biz",
   "title": "লাইসেন্স ও প্রতিষ্ঠান",
