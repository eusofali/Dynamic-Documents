 "css": ".doc-page .info-table td{padding-bottom:5px;vertical-align:top}.doc-page .info-table td:first-child{width:160px;font-weight:bold}.doc-page .info-table td:nth-child(2){width:20px;text-align:center}@media print{.doc-page .table-bordered th,.doc-page .table-bordered td{border:1px solid #000!important;padding:4px!important}}",
 "pages": [
  {
   "html": "<div>\n<strong>তারিখঃ</strong> {{app_date}} ইং<br><br>\n<strong>বরাবর,</strong><br>{{addressee}}<br>{{org_name}}<br>{{org_address}}<br><br>\nবিষয়ঃ <strong>{{position}}</strong> পদে {চাকুরীর জন্য আবেদন পত্র|নিয়োগের নিমিত্তে আবেদন|নিয়োগ প্রাপ্তির জন্য আবেদন}।<br><br>\n<strong>{জনাব|মহোদয়},</strong><br>\n{বিনীত নিবেদন এই যে,|যথাযথ সম্মান প্রদর্শনপূর্বক বিনীত নিবেদন এই যে,} আমি গত {{circular_date}} ইং তারিখে {{circular_source}} {এর মারফত|হতে|এর মাধ্যমে} জানতে পারলাম যে, আপনাদের {প্রতিষ্ঠানে|স্বনামধন্য প্রতিষ্ঠানে} {{position}} পদে {জনবল নিয়োগ করা হবে|কিছু সংখ্যক জনবল নিয়োগ দেওয়া হবে|লোক নিয়োগ করা হবে}। আমি উক্ত পদের একজন {আগ্রহী প্রার্থী হিসেবে|যোগ্য ও আগ্রহী প্রার্থী হিসেবে} নিম্নে আমার {প্রয়োজনীয় তথ্যাবলী|জীবন বৃত্তান্ত ও শিক্ষাগত যোগ্যতার বিবরণ} উপস্থাপন {করলাম|করিলাম}ঃ\n</div>\n<div class=\"mt-3\"><table class=\"info-table\" style=\"width:100%\">\n<tr><td>নাম</td><td>:</td><td>{{name}}</td></tr>\n<tr><td>পিতার নাম</td><td>:</td><td>{{father}}</td></tr>\n<tr><td>মাতার নাম</td><td>:</td><td>{{mother}}</td></tr>\n<tr><td>স্থায়ী ঠিকানা</td><td>:</td><td>{{permanent_address}}</td></tr>\n<tr><td>বর্তমান ঠিকানা</td><td>:</td><td>{{present_address}}</td></tr>\n<tr><td>জন্ম তারিখ</td><td>:</td><td>{{dob}}</td></tr>\n<tr><td>জাতীয় পরিচয়পত্র নং</td><td>:</td><td>{{nid}}</td></tr>\n<tr><td>জাতীয়তা</td><td>:</td><td>{{nationality}}</td></tr>\n<tr><td>বৈবাহিক অবস্থা</td><td>:</td><td>{{marital}}</td></tr>\n<tr><td>ধর্ম</td><td>:</td><td>{{religion}}</td></tr>\n<tr><td>যোগাযোগ নম্বর</td><td>:</td><td>{{mobile}}</td></tr>\n{{#if email}}<tr><td>ই-মেইল</td><td>:</td><td>{{email}}</td></tr>{{/if}}\n</table></div>\n{{#if edu}}<div class=\"mt-3\"><strong>শিক্ষাগত যোগ্যতাঃ</strong>\n<table class=\"table table-bordered table-sm text-center mt-2\" style=\"border-color:#000\"><thead><tr><th>পরীক্ষার নাম</th><th>বিষয়/বিভাগ</th><th>পাসের সাল</th><th>ফলাফল/জি.পি.এ</th><th>বোর্ড/বিশ্ববিদ্যালয়</th></tr></thead><tbody>\n{{#each edu}}<tr><td>{{exam}}</td><td>{{group}}</td><td>{{year}}</td><td>{{result}}</td><td>{{board}}</td></tr>{{/each}}\n</tbody></table></div>{{/if}}\n{{#if exp}}<div class=\"mt-2\"><strong>অভিজ্ঞতাঃ</strong>\n<table class=\"table table-bordered table-sm text-center mt-2\" style=\"border-color:#000\"><thead><tr><th>প্রতিষ্ঠানের নাম</th><th>পদবী</th><th>সময়কাল</th></tr></thead><tbody>\n{{#each exp}}<tr><td>{{org}}</td><td>{{post}}</td><td>{{duration}}</td></tr>{{/each}}\n</tbody></table></div>{{/if}}\n<div class=\"mt-3 text-justify\">{অতএব মহোদয়ের নিকট আমার বিনীত অনুরোধ,|অতএব, বিনীত প্রার্থনা,} অনুগ্রহ পূর্বক উপরোক্ত তথ্যাদি সদয় বিবেচনা করে উক্ত পদে নিয়োগ প্রদান করলে আমি আমার {কর্ম দক্ষতার দ্বারা|সর্বোচ্চ মেধা ও শ্রম দিয়ে} আপনার সন্তুষ্টি অর্জনে সক্ষম হব।</div>\n<div class=\"mt-5\"><table style=\"width:100%;border:none\"><tr>\n<td style=\"width:60%;vertical-align:top\"><strong>{সংযুক্তি|সংযুক্তিসমূহ|প্রয়োজনীয় কাগজপত্র}ঃ</strong><br>১। সকল শিক্ষাগত যোগ্যতার সনদপত্রের ফটোকপি।<br>২। জাতীয় পরিচয়পত্রের ফটোকপি।<br>৩। সদ্য তোলা পাসপোর্ট সাইজের ০২ (দুই) কপি রঙিন ছবি।<br>৪। চেয়ারম্যান কর্তৃক নাগরিকত্ব সনদ পত্র।</td>\n<td style=\"width:40%;text-align:right;vertical-align:bottom\"><strong>নিবেদক</strong><br><br><br>_______________________<br><strong>{{name}}</strong><br>মোবাইল নং- {{mobile}}</td>\n</tr></table></div>"
  }
 ],
 "id": "job_application",
 "version": 1
}
