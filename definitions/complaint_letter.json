{
 "id": "complaint_letter",
 "version": 1,
 "title": "অভিযোগপত্র",
 "title_en": "Complaint Letter",
 "category": "আবেদন / Applications",
 "icon": "fa-exclamation-circle",
 "description": "চেয়ারম্যান, ইউএনও, ওসি বা অন্য কর্তৃপক্ষের নিকট অভিযোগ।",
 "page": {
  "size": "a4",
  "marginTop": "0.7in",
  "margin": "1in",
  "fontSize": 16,
  "lineHeight": 1.55,
  "font": "bn"
 },
 "digits": "bn",
 "letterhead": true,
 "groups": [
  {
   "id": "g_to",
   "title": "প্রাপক ও তারিখ",
   "icon": "fa-envelope"
  },
  {
   "id": "g_me",
   "title": "আবেদনকারীর তথ্য",
   "icon": "fa-user"
  },
  {
   "id": "g_cp",
   "title": "অভিযোগের বিবরণ",
   "icon": "fa-gavel"
  },
  {
   "id": "g_att",
   "title": "সংযুক্তি",
   "icon": "fa-paperclip"
  }
 ],
 "fields": [
  {
   "name": "date",
   "label": "তারিখ",
   "type": "date",
   "col": 4,
   "group": "g_to",
   "required": true,
   "default": "today"
  },
  {
   "name": "addressee",
   "label": "প্রাপকের পদবী",
   "type": "text",
   "col": 8,
   "group": "g_to",
   "required": true,
   "default": "চেয়ারম্যান / উপজেলা নির্বাহী অফিসার / ভারপ্রাপ্ত কর্মকর্তা"
  },
  {
   "name": "org",
   "label": "দপ্তর / থানা / ইউনিয়ন পরিষদের নাম",
   "type": "text",
   "col": 6,
   "group": "g_to",
   "required": true
  },
  {
   "name": "org_address",
   "label": "প্রতিষ্ঠানের ঠিকানা (ঐচ্ছিক)",
   "type": "text",
   "col": 6,
   "group": "g_to"
  },
  {
   "name": "name",
   "label": "আবেদনকারীর নাম",
   "type": "text",
   "col": 6,
   "group": "g_me",
   "required": true
  },
  {
   "name": "father",
   "label": "পিতা/স্বামীর নাম",
   "type": "text",
   "col": 6,
   "group": "g_me"
  },
  {
   "name": "address",
   "label": "ঠিকানা",
   "type": "text",
   "col": 8,
   "group": "g_me",
   "required": true,
   "placeholder": "গ্রাম/মহল্লা, ডাকঘর, উপজেলা, জেলা"
  },
  {
   "name": "mobile",
   "label": "মোবাইল নম্বর",
   "type": "text",
   "col": 4,
   "group": "g_me",
   "required": true,
   "bn": true
  },
  {
   "name": "subject",
   "label": "অভিযোগের বিষয়",
   "type": "text",
   "col": 12,
   "group": "g_cp",
   "required": true,
   "placeholder": "যেমন: জমি জবরদখলের অভিযোগ"
  },
  {
   "name": "incident_date",
   "label": "ঘটনার তারিখ (জানা থাকলে)",
   "type": "date",
   "col": 4,
   "group": "g_cp"
  },
  {
   "name": "place",
   "label": "ঘটনাস্থল",
   "type": "text",
   "col": 8,
   "group": "g_cp"
  },
  {
   "name": "accused",
   "label": "অভিযুক্ত ব্যক্তি / প্রতিষ্ঠান (থাকলে)",
   "type": "text",
   "col": 12,
   "group": "g_cp"
  },
  {
   "name": "details",
   "label": "ঘটনার বিবরণ",
   "type": "textarea",
   "col": 12,
   "group": "g_cp",
   "required": true,
   "rows": 7,
   "placeholder": "ঘটনাটি ধারাবাহিকভাবে লিখুন।"
  },
  {
   "name": "demand",
   "label": "প্রার্থনা / প্রতিকার",
   "type": "textarea",
   "col": 12,
   "group": "g_cp",
   "rows": 2,
   "default": "উক্ত বিষয়ে তদন্ত করে আইনানুগ ব্যবস্থা গ্রহণ করা হোক।"
  },
  {
   "name": "attachments",
   "label": "সংযুক্তি (প্রতি লাইনে একটি; না লাগলে মুছে দিন)",
   "type": "textarea",
   "col": 12,
   "group": "g_att",
   "rows": 3,
   "default": "১। সংশ্লিষ্ট কাগজপত্রের ফটোকপি।\n২। জাতীয় পরিচয়পত্রের ফটোকপি।"
  }
 ],
 "css": ".doc-page .letter-sign{display:flex;justify-content:space-between;align-items:flex-end;gap:24px;margin-top:34px;break-inside:avoid}.doc-page .letter-att{font-size:.92em;max-width:50%}.doc-page .letter-me{text-align:right;line-height:1.4}.doc-page .letter p{margin-bottom:.8em}",
 "pages": [
  {
   "html": "<div class=\"letter\">\n<p class=\"mb-3\">তারিখ: {{date}} ইং</p>\n<p class=\"mb-3\">বরাবর,<br>{{addressee}}<br>{{org}}{{#if org_address}}<br>{{org_address}}{{/if}}</p>\n<p class=\"mb-3\"><strong>বিষয়ঃ {{subject}}।</strong></p>\n<p class=\"mb-2\">{জনাব|মহোদয়},</p>\n<div class=\"text-justify\">\n<p>{সবিনয় নিবেদন এই যে,|বিনীত নিবেদন এই যে,} আমি <strong>{{address}}</strong> ঠিকানার একজন বাসিন্দা।{{#if accused}} <strong>{{accused}}</strong> এর বিরুদ্ধে আমি নিম্নোক্ত অভিযোগ দায়ের করছি।{{else}} আমি নিম্নোক্ত অভিযোগ দায়ের করছি।{{/if}}</p>\n<p>{{#if incident_date}}ঘটনার তারিখ- {{incident_date}} ইং।<br>{{/if}}{{#if place}}ঘটনাস্থল- {{place}}।<br>{{/if}}</p>\n<p>{{details}}</p>\n<p>{অতএব, মহোদয়ের নিকট বিনীত প্রার্থনা,|অতএব, মহোদয়ের নিকট বিনীত অনুরোধ,} {{demand}}</p>\n</div>\n<div class=\"letter-sign\">\n<div class=\"letter-att\">{{#if attachments}}<strong>সংযুক্তিঃ</strong><br>{{attachments}}{{/if}}</div>\n<div class=\"letter-me\">{বিনীত নিবেদক|নিবেদক},<br><br><br>_______________________<br><strong>{{name}}</strong>{{#if father}}<br>পিতা/স্বামী- {{father}}{{/if}}<br>{{address}}<br>মোবাইল- {{mobile}}</div>\n</div>\n</div>"
  }
 ]
}
