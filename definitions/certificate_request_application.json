{
 "id": "certificate_request_application",
 "version": 1,
 "title": "সনদ / প্রত্যয়নপত্রের আবেদন",
 "title_en": "Certificate Request",
 "category": "আবেদন / Applications",
 "icon": "fa-certificate",
 "description": "চারিত্রিক, নাগরিকত্ব, ওয়ারিশান, আয়, বসবাস ইত্যাদি সনদের আবেদন।",
 "page": {
  "size": "a4",
  "marginTop": "0.7in",
  "margin": "1in",
  "fontSize": 16,
  "lineHeight": 1.55,
  "font": "bn"
 },
 "digits": "bn",
 "letterhead": true,
 "groups": [
  {
   "id": "g_to",
   "title": "প্রাপক ও তারিখ",
   "icon": "fa-envelope"
  },
  {
   "id": "g_me",
   "title": "আবেদনকারীর তথ্য",
   "icon": "fa-user"
  },
  {
   "id": "g_ct",
   "title": "সনদের তথ্য",
   "icon": "fa-certificate"
  },
  {
   "id": "g_att",
   "title": "সংযুক্তি",
   "icon": "fa-paperclip"
  }
 ],
 "fields": [
  {
   "name": "date",
   "label": "তারিখ",
   "type": "date",
   "col": 4,
   "group": "g_to",
   "required": true,
   "default": "today"
  },
  {
   "name": "addressee",
   "label": "প্রাপকের পদবী",
   "type": "text",
   "col": 8,
   "group": "g_to",
   "required": true,
   "default": "চেয়ারম্যান / মেয়র / ওয়ার্ড কাউন্সিলর"
  },
  {
   "name": "org",
   "label": "ইউনিয়ন পরিষদ / পৌরসভার নাম",
   "type": "text",
   "col": 6,
   "group": "g_to",
   "required": true
  },
  {
   "name": "org_address",
   "label": "প্রতিষ্ঠানের ঠিকানা (ঐচ্ছিক)",
   "type": "text",
   "col": 6,
   "group": "g_to"
  },
  {
   "name": "name",
   "label": "আবেদনকারীর নাম",
   "type": "text",
   "col": 6,
   "group": "g_me",
   "required": true
  },
  {
   "name": "father",
   "label": "পিতা/স্বামীর নাম",
   "type": "text",
   "col": 6,
   "group": "g_me"
  },
  {
   "name": "address",
   "label": "ঠিকানা",
   "type": "text",
   "col": 8,
   "group": "g_me",
   "required": true,
   "placeholder": "গ্রাম/মহল্লা, ডাকঘর, উপজেলা, জেলা"
  },
  {
   "name": "mobile",
   "label": "মোবাইল নম্বর",
   "type": "text",
   "col": 4,
   "group": "g_me",
   "required": true,
   "bn": true
  },
  {
   "name": "cert",
   "label": "সনদের ধরন",
   "type": "select",
   "col": 6,
   "group": "g_ct",
   "options": [
    "চারিত্রিক সনদ",
    "নাগরিকত্ব সনদ",
    "ওয়ারিশান সনদ",
    "আয়ের প্রত্যয়নপত্র",
    "বসবাসের প্রত্যয়নপত্র (স্থায়ী বাসিন্দা সনদ)",
    "অবিবাহিত সনদ",
    "জন্ম/মৃত্যু সনদ",
    "অন্যান্য"
   ],
   "default": "চারিত্রিক সনদ"
  },
  {
   "name": "cert_other",
   "label": "অন্য সনদ হলে নাম লিখুন",
   "type": "text",
   "col": 6,
   "group": "g_ct"
  },
  {
   "name": "purpose",
   "label": "কী প্রয়োজনে",
   "type": "text",
   "col": 12,
   "group": "g_ct",
   "required": true,
   "placeholder": "যেমন: চাকুরীর আবেদনের জন্য / পাসপোর্টের জন্য"
  },
  {
   "name": "attachments",
   "label": "সংযুক্তি (প্রতি লাইনে একটি; না লাগলে মুছে দিন)",
   "type": "textarea",
   "col": 12,
   "group": "g_att",
   "rows": 3,
   "default": "১। জাতীয় পরিচয়পত্র / জন্ম নিবন্ধনের ফটোকপি।\n২। পাসপোর্ট সাইজের ছবি ০২ কপি।\n৩। হালনাগাদ কর পরিশোধের রসিদ।"
  }
 ],
 "css": ".doc-page .letter-sign{display:flex;justify-content:space-between;align-items:flex-end;gap:24px;margin-top:34px;break-inside:avoid}.doc-page .letter-att{font-size:.92em;max-width:50%}.doc-page .letter-me{text-align:right;line-height:1.4}.doc-page .letter p{margin-bottom:.8em}",
 "pages": [
  {
   "html": "<div class=\"letter\">\n<p class=\"mb-3\">তারিখ: {{date}} ইং</p>\n<p class=\"mb-3\">বরাবর,<br>{{addressee}}<br>{{org}}{{#if org_address}}<br>{{org_address}}{{/if}}</p>\n<p class=\"mb-3\"><strong>বিষয়ঃ {{#if cert_other}}{{cert_other}}{{else}}{{cert}}{{/if}} প্রদানের আবেদন।</strong></p>\n<p class=\"mb-2\">{জনাব|মহোদয়},</p>\n<div class=\"text-justify\">\n<p>{সবিনয় নিবেদন এই যে,|বিনীত নিবেদন এই যে,} আমি <strong>{{address}}</strong> ঠিকানার স্থায়ী বাসিন্দা। {{purpose}} আমার একটি <strong>{{#if cert_other}}{{cert_other}}{{else}}{{cert}}{{/if}}</strong> প্রয়োজন।</p>\n<p>{অতএব, মহোদয়ের নিকট বিনীত প্রার্থনা,|অতএব, মহোদয়ের নিকট বিনীত অনুরোধ,} নিয়ম অনুযায়ী প্রয়োজনীয় ফি গ্রহণ সাপেক্ষে আমাকে উক্ত সনদ {প্রদান করে বাধিত করবেন|প্রদানের ব্যবস্থা গ্রহণ করবেন}।</p>\n</div>\n<div class=\"letter-sign\">\n<div class=\"letter-att\">{{#if attachments}}<strong>সংযুক্তিঃ</strong><br>{{attachments}}{{/if}}</div>\n<div class=\"letter-me\">{বিনীত নিবেদক|নিবেদক},<br><br><br>_______________________<br><strong>{{name}}</strong>{{#if father}}<br>পিতা/স্বামী- {{father}}{{/if}}<br>{{address}}<br>মোবাইল- {{mobile}}</div>\n</div>\n</div>"
  }
 ]
}
