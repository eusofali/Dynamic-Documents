   "class": "ov-page",
   "html": "<div class=\"ov\" style=\"transform:translate({{cal_x}}mm,{{cal_y}}mm)\"><div class=\"ov-in\" style=\"{{#if layout==one}}transform:translateY(-1.2mm){{/if}}\">\n<div class=\"o\" style=\"left:55.0mm;top:33.1mm;width:81.6mm\">{{lic_no}}</div>\n<div class=\"o\" style=\"left:55.0mm;top:41.9mm;width:81.6mm\">{{lic_id}}</div>\n<div class=\"o\" style=\"left:55.0mm;top:48.7mm;width:81.6mm\">{{ward}}</div>\n<div class=\"o sm\" style=\"left:55.0mm;top:55.5mm;width:88.3mm\">{{circle}}</div>\n<div class=\"o\" style=\"left:55.0mm;top:62.2mm;width:81.6mm\">{{issue_date}}</div>\n<div class=\"o\" style=\"left:55.0mm;top:68.9mm;width:81.6mm\">{{fy}}</div>\n<div class=\"o\" style=\"left:55.0mm;top:75.6mm;width:81.6mm\">{{renew_date}}</div>\n<div class=\"o r\" style=\"left:127.8mm;top:92.4mm;width:17.7mm\">{{valid_year}}</div>\n<div class=\"o\" style=\"left:51.7mm;top:101.4mm;width:135.9mm\">{{biz_name}}</div>\n<div class=\"o sm\" style=\"left:51.7mm;top:110.8mm;width:135.9mm\">{{biz_type}}</div>\n<div class=\"o\" style=\"left:51.7mm;top:120.0mm;width:135.9mm\">{{owner}}</div>\n<div class=\"o\" style=\"left:51.7mm;top:129.6mm;width:135.9mm\">{{father}}</div>\n<div class=\"o\" style=\"left:51.7mm;top:139.0mm;width:135.9mm\">{{mother}}</div>\n<div class=\"o sm\" style=\"left:51.7mm;top:148.2mm;width:135.9mm\">{{biz_address}}</div>\n<div class=\"o sm\" style=\"left:51.7mm;top:157.4mm;width:135.9mm\">{{pres_address}}</div>\n<div class=\"o sm\" style=\"left:51.7mm;top:167.2mm;width:135.9mm\">{{#if same_addr}}{{pres_address}}{{else}}{{perm_address}}{{/if}}</div>\n<div class=\"o\" style=\"left:51.7mm;top:176.7mm;width:95.1mm\">{{nid}}</div>\n<div class=\"o\" style=\"left:51.7mm;top:185.8mm;width:57.1mm\">{{phone}}</div>\n<div class=\"o\" style=\"left:139.3mm;top:185.8mm;width:48.9mm\">{{tin}}</div>\n{{#if layout==one}}\n<div class=\"o r\" style=\"left:106.0mm;top:207.5mm;width:26.5mm\">{{f_lic}}</div>\n<div class=\"o r\" style=\"left:106.0mm;top:213.1mm;width:26.5mm\">{{f_sign}}</div>\n<div class=\"o r\" style=\"left:106.0mm;top:218.6mm;width:26.5mm\">{{f_misc}}</div>\n<div class=\"o r\" style=\"left:106.0mm;top:224.1mm;width:26.5mm\">{{f_arrears}}</div>\n<div class=\"o r\" style=\"left:106.0mm;top:229.6mm;width:26.5mm\">{{f_sur}}</div>\n<div class=\"o r\" style=\"left:106.0mm;top:235.1mm;width:26.5mm\">{{grand1}}</div>\n<div class=\"o r\" style=\"left:107.4mm;top:245.0mm;width:20.4mm\">{{grand1}}</div>\n{{else}}\n<div class=\"o r\" style=\"left:104.7mm;top:206.4mm;width:26.5mm\">{{f_lic}}</div>\n<div class=\"o r\" style=\"left:104.7mm;top:212.4mm;width:26.5mm\">{{f_sign}}</div>\n<div class=\"o r\" style=\"left:104.7mm;top:218.4mm;width:26.5mm\">{{f_misc}}</div>\n<div class=\"o r\" style=\"left:104.7mm;top:224.4mm;width:26.5mm\">{{f_arrears}}</div>\n<div class=\"o r\" style=\"left:104.7mm;top:230.3mm;width:26.5mm\">{{f_sur}}</div>\n<div class=\"o r\" style=\"left:104.7mm;top:236.3mm;width:26.5mm\">{{grand}}</div>\n<div class=\"o r\" style=\"left:160.4mm;top:206.4mm;width:26.5mm\">{{f_hal}}</div>\n<div class=\"o r\" style=\"left:160.4mm;top:212.4mm;width:26.5mm\">{{f_vat}}</div>\n<div class=\"o r\" style=\"left:160.4mm;top:218.4mm;width:26.5mm\">{{f_vat_arr}}</div>\n<div class=\"o r\" style=\"left:160.4mm;top:224.4mm;width:26.5mm\">{{f_tax}}</div>\n<div class=\"o r\" style=\"left:160.4mm;top:230.3mm;width:26.5mm\">{{f_tax_arr}}</div>\n<div class=\"o r\" style=\"left:160.4mm;top:236.3mm;width:26.5mm\">{{f_app}}</div>\n<div class=\"o r\" style=\"left:107.4mm;top:245.0mm;width:20.4mm\">{{grand}}</div>\n{{/if}}\n<div class=\"o pbox\" style=\"left:150.2mm;top:33.0mm;width:40.5mm;height:48.7mm\">{{photo}}</div>\n</div></div>"
